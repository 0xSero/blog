{
  "name": "sybil-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next dev",
    "build": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next build",
    "serve": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next start",
    "analyze": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next build --experimental-analyze",
    "lint": "oxlint app components lib layouts scripts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "framer-motion": "^12.40.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "2.0.2",
    "lucide-react": "^1.16.0",
    "mdx-bundler": "^10.1.1",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "globby": "16.2.0",
    "husky": "^9.1.7",
    "inquirer": "^13.4.3",
    "lint-staged": "^17.0.5",
    "next-remote-watch": "^2.0.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "oxfmt"
    ]
  }
}
